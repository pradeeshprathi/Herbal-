# ------------------------------------------------------------------
# BUDDY herbal - environment configuration
# Copy this file to ".env" and edit the values you need.
# ------------------------------------------------------------------

# Business WhatsApp number in international format, digits only.
WHATSAPP_NUMBER=918903247497

# ---- WhatsApp Cloud API (optional) -------------------------------
# Leave both empty to run in SIMULATED mode: every WhatsApp message
# is stored in the outbox and shown in the "WhatsApp bot" demo panel
# instead of being sent for real. Fill them in to send for real.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=buddy-herbal-verify
WHATSAPP_API_VERSION=v20.0

# ---- Live order tracking -----------------------------------------
# Seconds each tracking stage lasts. 45 = the whole journey
# (ordered -> delivered) takes about 4 minutes, nice for a demo.
# Set to 0 to freeze orders at "ordered".
STAGE_SECONDS=45

# ---- Owner dashboard (/owner.html) ------------------------------
# The password for the owner dashboard. CHANGE THIS before going live.
OWNER_PASSWORD=buddy-owner
OWNER_SESSION_HOURS=12
# Optional: a random string used to sign the owner cookie.
SECRET_KEY=

# ---- App ---------------------------------------------------------
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Where orders are stored. Leave this commented out: the app then uses
# backend/data/buddy_herbal.db next to the code, whatever folder you start it from.
# DATABASE_URL=sqlite:///./backend/data/buddy_herbal.db
